# Backend environment — copy to server/.env and fill in your real values.
# This file is a tracked template; server/.env is git-ignored.
#
# For Clever Cloud: leave DB_* blank and set MYSQL_ADDON_URI instead — the
# server parses that URI automatically and it takes priority.
# For local/XAMPP dev: set DB_* below.

# ─── Database ─────────────────────────────────────────────────────────
# Local MySQL / MariaDB (XAMPP on Windows defaults to user=root, no password):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=stbabeth_tss

# Clever Cloud (set this instead of DB_* when deployed on Clever Cloud):
# MYSQL_ADDON_URI=mysql://user:pass@host:3306/database

# ─── Server ───────────────────────────────────────────────────────────
PORT=4000
# Comma-separated list of origins allowed to call the API (no spaces around commas).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set to "true" to also allow all localhost dev ports (useful while developing).
ALLOW_LOCAL_ORIGINS=true
# Public URL of the API (so uploaded file links resolve from the browser).
# Local development: http://localhost:4000
# Render production: https://your-service-name.onrender.com (your Render backend URL)
# This MUST be set in production — otherwise uploaded file links will be broken.
PUBLIC_API_URL=http://localhost:4000

# Production: the origin(s) your frontend is deployed at (comma-separated, no trailing slash).
# Example for Render: CORS_ORIGIN=https://cpecstbabeth.rw,https://www.cpecstbabeth.rw
# Example for GitHub Pages: CORS_ORIGIN=https://yourusername.github.io

# ─── Auth ─────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# REQUIRED in production — generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Never commit a real secret. This placeholder will cause the server to refuse
# to start in production (ALLOW_LOCAL_ORIGINS must NOT be "true" in production).
JWT_SECRET=dev_secret_change_me_in_production_32_chars_min

# ─── Seeding (optional overrides for db:seed) ─────────────────────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# ─── Supabase Storage ─────────────────────────────────────────────────
# Required for file uploads in production. Create a project at supabase.com,
# then get these values from: Project Settings > API.
# SUPABASE_SECRET_KEY is the "secret" key (privileged — backend only, never expose to frontend).
# SUPABASE_URL is your project URL, e.g. https://xxxxxxxx.supabase.co
# SUPABASE_BUCKET is the PUBLIC bucket (default: "uploads") for gallery/hero/
#   banner/teacher images and public learning resources.
# SUPABASE_PRIVATE_BUCKET is a SEPARATE bucket (default: "private") for
#   sensitive per-person documents — student reports, admission report and
#   feedback attachments. Create it in the Supabase dashboard WITHOUT
#   enabling "Public bucket". If left public, this app's short-lived signed
#   URLs still work, but the object is ALSO reachable forever via its direct
#   public URL — defeating the point of signing. Bucket privacy is a
#   Supabase dashboard setting; this app cannot enforce it from code.
# Without these, uploads fall back to local disk — fine for local dev only,
# never for production (not persistent across redeploys, and private
# categories are only protected by a homemade signed link, not a real
# private bucket).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=uploads
SUPABASE_PRIVATE_BUCKET=private

# ─── Cloudflare R2 (legacy cleanup only — NOT an active upload destination) ─
# New uploads never go to R2 anymore; Supabase Storage is the only supported
# production backend. These vars are only read by the cleanup script /
# delete path, to remove objects created under an older setup that used R2.
# Leave blank on new deployments.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=
