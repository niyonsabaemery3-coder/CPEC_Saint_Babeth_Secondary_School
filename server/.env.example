# Copy this file to .env and fill in real values. Never commit the real .env.

PORT=4000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=stbabeth
DB_PASSWORD=change_me
DB_NAME=stbabeth_tss

# Used to sign login tokens (admin + teacher). Use a long random string in production.
JWT_SECRET=change_this_to_a_long_random_string

# Default admin account created by `npm run db:seed` (only if no admin exists yet)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# Comma-separated list of origins allowed to call this API (your deployed frontend URL(s))
CORS_ORIGIN=http://localhost:5173

# Optional: set this to your API's public URL (e.g. https://api.yourdomain.com) in production
# so uploaded file links always point to the right place. If left blank, the server infers
# it automatically from each request, which works fine for most setups.
PUBLIC_API_URL=
