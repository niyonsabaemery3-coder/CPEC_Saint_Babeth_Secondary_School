# Backend environment — copy to server/.env and fill in your real values.
# This file is a tracked template; server/.env is git-ignored.
#
# For Clever Cloud: leave DB_* blank and set MYSQL_ADDON_URI instead — the
# server parses that URI automatically and it takes priority.
# For local/XAMPP dev: set DB_* below.

# ─── Database ─────────────────────────────────────────────────────────
# Local MySQL / MariaDB (XAMPP on Windows defaults to user=root, no password):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=stbabeth_tss

# Clever Cloud (set this instead of DB_* when deployed on Clever Cloud):
# MYSQL_ADDON_URI=mysql://user:pass@host:3306/database

# ─── Server ───────────────────────────────────────────────────────────
PORT=4000
# Comma-separated list of origins allowed to call the API (no spaces around commas).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set to "true" to also allow all localhost dev ports (useful while developing).
ALLOW_LOCAL_ORIGINS=true
# Public URL of the API (so uploaded file links resolve from the browser).
PUBLIC_API_URL=http://localhost:4000

# ─── Auth ─────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=dev_secret_change_me_in_production_32_chars_min

# ─── Seeding (optional overrides for db:seed) ─────────────────────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
